{
  "name": "atlas-threat-intel",
  "private": true,
  "version": "0.1.0",
  "description": "Threat Intelligence Search & Explore (eSentire take-home)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "setup": "npm run env:init && npm run db:up && npm run generate -w server && npm run db:migrate && npm run seed",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run build -w server && npm run build -w client",
    "env:init": "node -e \"const f=require('fs');if(!f.existsSync('server/.env')){f.copyFileSync('server/.env.example','server/.env');console.log('created server/.env')}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false
  }
}
