{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx src/ingestion/cli.ts ../data/intel.json",
    "test": "jest --runInBand",
    "migrate:test": "node -e \"require('dotenv').config({quiet:true});process.env.DATABASE_URL=process.env.TEST_DATABASE_URL;require('child_process').execSync('npx prisma migrate deploy',{stdio:'inherit'})\"",
    "pretest": "npm run migrate:test --silent",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
