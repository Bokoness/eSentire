# Local Postgres from docker-compose.yml (host port 5433). Dev-only credentials.
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas?schema=public"
# Separate database used by Jest integration tests.
TEST_DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas_test?schema=public"
# API port. Not "PORT", which many tools set for the frontend dev server.
API_PORT=3001
